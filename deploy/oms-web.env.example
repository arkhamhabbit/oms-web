# Environment for the oms-web container (the admin console). No secret belongs here: the console
# is static files, and everything below is public to anyone who opens the page.
# Copy to a real env file on the server; never commit the copy.

# Port: the container listens on 8080 (map it, e.g. 127.0.0.1:8081:8080). Health: GET /healthz -> 200.

# REQUIRED. Where the OMS API is, as the browser reaches it: scheme and host (and port), no path.
# Read at container start; the same image serves any environment. If it is missing or malformed the
# console shows one page naming this variable instead of the app.
# Keep the console and the OMS on the same parent domain (DECISIONS section 2, Deployment constraint).
OMS_API_BASE_URL=https://oms-test.habbithealth.com

# The origin product and content images are loaded from: the public base address of the media
# bucket, the same value the OMS has as MEDIA_PUBLIC_BASE_URL (scheme and host only, no path; if
# that value has a path, give only its origin here). It is also where signed uploads are sent.
# If unset, images are allowed from the console's own address and inline data only.
MEDIA_ORIGIN=https://storage.googleapis.com
